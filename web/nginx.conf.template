# Rendered by the nginx image envsubst entrypoint.
# Substitutes ${API_UPSTREAM} and ${MAX_UPLOAD_BYTES} only (other $vars are nginx).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # No access log: a line per request with the client's address and user agent would tie
    # people to addresses once matched by time with the API's own log.
    access_log off;

    absolute_redirect off;
    port_in_redirect off;

    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    client_max_body_size ${MAX_UPLOAD_BYTES};

    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml font/woff2;
    gzip_min_length 1024;

    location = /api {
        rewrite ^ /api/ last;
    }

    # Docker embedded DNS. Variable proxy_pass re-resolves `api` when the
    # API container is recreated (a static proxy_pass caches the old IP).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        include /etc/nginx/api-proxy.conf;
        set $shroud_api ${API_UPSTREAM};
        proxy_pass $shroud_api;
    }

    location /assets/ {
        include /etc/nginx/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Hashed ONNX WASM / factory from the Whisper worker. nginx:alpine
    # already maps these, but an explicit type keeps a custom mime.types
    # from serving them as octet-stream (ORT then refuses to compile).
    location ~* \.wasm$ {
        include /etc/nginx/security-headers.conf;
        default_type application/wasm;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.mjs$ {
        include /etc/nginx/security-headers.conf;
        default_type application/javascript;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    location = /config.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # The Web Push service worker. Always revalidated so a new version reaches browsers on
    # their next visit; a missing file must 404, never fall back to index.html (a worker
    # served as HTML fails to register).
    location = /sw.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        default_type application/javascript;
        try_files $uri =404;
    }

    # Settings → About Shroud → Open-Source Licenses, written by every build under the same name
    # (bundleLicenses.ts): revalidated so a deploy's list replaces the last one; a missing file
    # must 404, never fall back to index.html.
    location = /licenses.json {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        default_type application/json;
        try_files $uri =404;
    }

    # Notification sounds. Stock mime.types has no wav, and an octet-stream answer with nosniff
    # is one Safari will not play.
    location /sounds/ {
        include /etc/nginx/security-headers.conf;
        types { audio/wav wav; }
        default_type audio/wav;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
