{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "created_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "devices": {
            "type": "integer",
            "minimum": 0
          },
          "last_active_on": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "push": {
            "enum": [
              "apns",
              "web",
              "unifiedpush",
              "none",
              "mixed"
            ]
          },
          "status": {
            "enum": [
              "active",
              "deleted"
            ]
          }
        },
        "required": [
          "id",
          "created_on",
          "devices",
          "last_active_on",
          "push",
          "status"
        ]
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "accounts",
        "active",
        "deleted"
      ]
    }
  },
  "required": [
    "items",
    "next_cursor",
    "totals"
  ]
}
