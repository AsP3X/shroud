{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "active",
        "deleted"
      ]
    },
    "last_active_on": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contacts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "blocks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "conversations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "media_objects": {
          "type": "integer",
          "minimum": 0
        },
        "media_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "contacts",
        "blocks",
        "conversations",
        "media_objects",
        "media_bytes"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "platform": {
            "enum": [
              "ios",
              "web",
              "android",
              "unknown"
            ]
          },
          "added_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_seen_on": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "revoked": {
            "type": "boolean"
          },
          "push": {
            "enum": [
              "apns",
              "apns+voip",
              "web",
              "unifiedpush",
              "none"
            ]
          },
          "session": {
            "enum": [
              "live",
              "none"
            ]
          }
        },
        "required": [
          "id",
          "platform",
          "added_on",
          "last_seen_on",
          "revoked",
          "push",
          "session"
        ]
      }
    },
    "pin_guard": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "created_on",
    "status",
    "last_active_on",
    "counts",
    "devices",
    "pin_guard"
  ]
}
