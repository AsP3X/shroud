{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "upstream": {
      "enum": [
        "postgres",
        "api"
      ]
    }
  },
  "required": [
    "code",
    "message"
  ]
}
