{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "item": {
        "type": "string",
        "minLength": 1
      },
      "state": {
        "enum": [
          "ok",
          "failed",
          "off"
        ]
      },
      "detail": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "item",
      "state",
      "detail"
    ]
  }
}
