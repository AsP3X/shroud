# Server runtime configuration loaded from environment at startup.
# Agent: READS env(DATABASE_URL, HOST, PORT); validated before bind; no secrets logged.
DATABASE_URL=postgres://shroud:shroud@127.0.0.1:5432/shroud
# Max sqlx pool connections for this process (default 10).
DATABASE_POOL_MAX=10
# Apply sqlx migrations at startup (default true). Set false on non-migrator replicas.
RUN_MIGRATIONS=true
# Honor X-Forwarded-For / X-Real-IP for rate-limit keys (default false). Set true only behind a trusted proxy.
TRUST_FORWARDED_HEADERS=false
HOST=127.0.0.1
PORT=8080
# Media blobs (ciphertext, API-proxied upload/download). Without NEBULAR_URL they are files in
# this directory; with it, this is the older volume the API moves into Nebular on start.
MEDIA_DATA_DIR=./data/shroud-media
# Logging (Ownly-style). Prefer debug for local; use info/warn in production.
# Examples:
#   RUST_LOG=debug
#   RUST_LOG=shroud_server=debug,tower_http=info,sqlx=warn
#   RUST_LOG=shroud_server::routes=trace,tower_http=debug
RUST_LOG=shroud_server=debug,tower_http=debug,sqlx=warn
# RUST_LOG_FORMAT=json
# Nebular OS, the media store (unset = files under MEDIA_DATA_DIR). Compose publishes it on
# 127.0.0.1:9000; inside the stack the API uses http://nebular:9000.
NEBULAR_URL=http://127.0.0.1:9000
NEBULAR_MEDIA_BUCKET=shroud-media
# The API's SigV4 access key, required with NEBULAR_URL: the same pair as Nebular's
# NOS_S3_ACCESS_KEY / NOS_S3_SECRET_KEY. Copy them from the repository's .env (the wizard
# writes them there).
NEBULAR_ACCESS_KEY_ID=
NEBULAR_SECRET_ACCESS_KEY=
# NEBULAR_REGION=us-east-1   # only scopes the signature; Nebular accepts any
# Optional: Redis for multi-replica WebSocket fan-out. Unset = in-process only.
REDIS_URL=redis://:shroud@127.0.0.1:6379
# Optional: live APNs HTTP/2 (token auth). Unset = PUT /push/token works; send is log-only.
# Provide either APNS_KEY_PATH or APNS_KEY_PEM (PKCS#8 .p8 PEM), plus KEY_ID / TEAM_ID / TOPIC.
# Device sandbox|production is taken from each registered push_tokens row (not APNS_ENVIRONMENT).
# APNS_KEY_PATH=/path/to/AuthKey_XXX.p8
# APNS_KEY_PEM=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.example.shroud
# WebRTC ICE for calls (docs/calls.md). Without TURN_* clients get Google's STUN server only.
# TURN with logins minted per user (coturn --use-auth-secret; STUN then comes from the same
# coturn): TURN_SECRET is coturn's static-auth-secret, at least 16 characters.
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# TURN_SECRET=
# TURN_CREDENTIAL_TTL_SECS=43200
# A hosted TURN service with one fixed login instead (TURN_SECRET wins when both are set):
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Or full JSON (replaces the STUN default and the fixed login, not minted TURN):
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

