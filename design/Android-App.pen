              "name": "Body",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Fingerprint (or the enrolled biometric) through the system BiometricPrompt instead of Face ID; “Use screen lock” instead of the device passcode. See Locked — System Biometric Prompt.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
