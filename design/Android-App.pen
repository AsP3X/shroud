    {
      "type": "frame",
      "id": "uROl2",
      "x": 3301,
      "y": 110,
      "name": "Android · Platform Notes",
      "width": 760,
      "fill": "$bg",
      "cornerRadius": 28,
      "layout": "vertical",
      "gap": 20,
      "padding": 36,
      "children": [
        {
          "type": "text",
          "id": "OsuaV",
          "name": "Title",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Android — what differs from iOS",
          "fontFamily": "$font",
          "fontSize": 28,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "Qmqae",
          "name": "Lead",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Only what Android owns or cannot do is different. Everything else is the iOS design.",
          "fontFamily": "$font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "F62jgN",
          "name": "Note · Same design, same components",
          "width": "fill_container",
          "gap": 16,
          "children": [
            {
              "type": "text",
              "id": "vrZT3",
              "name": "Head",
              "fill": "$accent-text",
              "textGrowth": "fixed-width",
              "width": 150,
              "content": "Same design, same components",
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "tRGwp",
              "name": "Body",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Every screen, component, colour, type size, radius and motion note matches design/iOS-App.pen. The app draws its own chrome (glass app bar, floating tab bar, switches, sheets, context menus) instead of Material 3 widgets, so it looks the same on both phones.",
              "lineHeight": 1.45,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "SeCwD",
          "name": "Note · Frame",
