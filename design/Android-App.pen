    {
      "type": "frame",
      "id": "Gwp1b",
      "x": 1500,
      "y": 20320,
      "name": "Glass — Without Blur",
      "context": "Background blur needs Android 12 (RenderEffect / window blur) and can be switched off by battery saver or the device maker. Without it every glass surface — tab bar, glass circles and capsules, reply and link bars, context-menu scrim — keeps its shape, stroke and shadow and swaps the translucent fill for a near-opaque one (light #FFFFFFF5, dark #2C2C2EF5); the menu scrim becomes a plain dim (#0B0B1259) with no blur. Nothing else changes.",
      "fill": "$bg-grouped",
      "cornerRadius": 24,
      "layout": "vertical",
      "gap": 20,
      "padding": 24,
      "children": [
        {
          "type": "text",
          "id": "YZzQ8",
          "name": "Title",
          "fill": "$text-primary",
          "textGrowth": "fixed-width",
          "width": 848,
          "content": "Glass with and without blur",
          "fontFamily": "$font",
          "fontSize": 22,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "bfXCX",
          "name": "Note",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": 848,
          "content": "Left: Android 12+ with blur. Right: no blur available — same shapes, near-opaque fill, so text behind never shows through.",
          "fontFamily": "$font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
