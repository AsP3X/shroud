            {
              "type": "text",
              "id": "z9kD1",
              "name": "Body",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "A narrow window uses the iPhone layout from iOS-App.pen unchanged (one column, back button, full-width tab bar).",
