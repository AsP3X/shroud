        },
        {
          "type": "text",
          "id": "AlvUk",
          "name": "Intro",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "How the iPhone design maps onto iPad. Everything not listed here is the iPhone design: same components, colours, copy and states.",
