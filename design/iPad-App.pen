          "fontFamily": "$font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "JRMZ3",
          "name": "Note · Two columns",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "Y15l6",
              "name": "Heading",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Two columns",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fLZDN",
              "name": "Body",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Regular width: a 375 pt sidebar (320 pt in portrait and in small windows) and a detail column. The sidebar is the iPhone's tab root — Chats, Contacts, Calls, Settings — with the floating tab bar at its bottom. The detail column shows what the iPhone pushes.",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "jWwnj",
          "name": "Note · Detail is shared",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "zghlA",
              "name": "Heading",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Detail is shared",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "jiWKm",
              "name": "Body",
              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Switching tabs keeps the open conversation. With nothing open the detail shows the placeholder. A screen that is the root of the detail has no back button; the open row is tinted accent-soft in the sidebar.",
              "lineHeight": 1.4,
              "fontFamily": "$font",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "F7gBb",
          "name": "Note · Compact width",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 4,
          "children": [
            {
              "type": "text",
              "id": "YbVIJ",
              "name": "Heading",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Compact width",
