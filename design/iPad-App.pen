              "fill": "$text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Settings pages and the contact profile: 600 pt, centred in the detail. Onboarding, lock and log-out: a 400 pt column; top-bar buttons stay at the window edges.",
