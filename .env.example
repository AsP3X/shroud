# Copy to .env or run ./deploy.sh (wizard). Never commit .env.
# Agent: READ by docker compose; WRITTEN by scripts/setup.sh / setup.ps1.

# local = publish host ports (API :8080, web :8081)
# npm   = join the external proxy-network for Nginx Proxy Manager
PROXY_MODE=local

# Public URLs the wizard prints and the API uses for CORS.
# Web nginx always same-origin-proxies /api/v1 — browsers do not need a split API host.
WEB_PUBLIC_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:8080
WEB_PORT=8081
API_PORT=8080

# Comma-separated extra browser origins (usually just WEB_PUBLIC_URL).
CORS_ALLOWED_ORIGINS=http://localhost:8081

POSTGRES_USER=shroud
# Applied only the first time the Postgres volume is created. Do not rotate
# this without `./deploy.sh --down --volumes` or the API cannot log in.
POSTGRES_PASSWORD=GENERATE_ME
POSTGRES_DB=shroud

# Nebular OS, the media store. The wizard generates these, and ./deploy.sh adds any that are
# missing; keep them out of every other system.
#   NOS_JWT_SECRET            Nebular's own; nothing else needs it
#   NEBULAR_ACCESS_KEY_ID /   the API's SigV4 key: editor role on the shroud-media bucket only
#   NEBULAR_SECRET_ACCESS_KEY
#   NOS_METRICS_TOKEN         guards Nebular's /metrics
NOS_JWT_SECRET=GENERATE_ME
NEBULAR_ACCESS_KEY_ID=GENERATE_ME
NEBULAR_SECRET_ACCESS_KEY=GENERATE_ME
NOS_METRICS_TOKEN=GENERATE_ME

# Redis password (letters and digits only). ./deploy.sh fills in a missing one.
REDIS_PASSWORD=GENERATE_ME

RUST_LOG=info
RUST_LOG_FORMAT=text

# Optional APNs (iOS). Leave empty to log-only.
APNS_KEY_PATH=
APNS_KEY_PEM=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENVIRONMENT=sandbox

# Optional Web Push (browser notifications) — works without any of these. The server makes
# its own VAPID key on first start and keeps it in Postgres; set both keys only to bring your
# own (`npx web-push generate-vapid-keys`). A new key makes every browser subscribe again the
# next time it opens Shroud. SUBJECT is how push services reach you (mailto: or https:);
# it defaults to WEB_PUBLIC_URL when that is https.
WEB_PUSH_SUBJECT=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Push services beyond Google, Mozilla, Apple and Microsoft (comma-separated host suffixes).
WEB_PUSH_ALLOWED_HOSTS=

# Optional Android push (UnifiedPush) — works without any of these. The Android app is reached
# through a distributor app its user installs (ntfy, Sunup, …), with the same Web Push key.
# ntfy.sh, up.conversations.im and Mozilla's autopush are built in; Google's push hosts are
# never accepted for Android. Add your own distributor's push server here (comma-separated
# host suffixes, e.g. ntfy.example.org), or set UNIFIEDPUSH_PUBLIC_HOSTS=true to accept any
# https host whose every address is public (the server connects only to the addresses it
# checked).
UNIFIEDPUSH_ALLOWED_HOSTS=
UNIFIEDPUSH_PUBLIC_HOSTS=false

# Calls. Without a TURN relay, calls connect only where a direct path exists and fail between networks that block direct
# connections (many mobile carriers). To run the bundled coturn, set COMPOSE_PROFILES=calls,
# TURN_URLS to this server's public name, and a random TURN_SECRET (the wizard does all
# three). Open UDP/TCP 3478 and UDP TURN_MIN_PORT–TURN_MAX_PORT. coturn accepts only the
# short-lived logins the API mints with TURN_SECRET; there is no shared password.
COMPOSE_PROFILES=
# e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
# Letters and digits only (the coturn image's entrypoint shell-evaluates its arguments);
# `openssl rand -hex 32`. deploy.sh fills in a missing one.
TURN_SECRET=GENERATE_ME
TURN_REALM=shroud
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
# Only for a hosted TURN service with one fixed login (never with the bundled coturn).
TURN_USERNAME=
TURN_CREDENTIAL=
